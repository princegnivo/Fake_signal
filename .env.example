# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_TOKEN=votre_token_ici

# Configuration
SIGNAL_INTERVAL=120  # Intervalle d'envoi en secondes
ENTRY_DELAY=3        # Délai d'entrée en minutes
MARTINGALE_INTERVAL=1 # Intervalle des martingales en minutes
EXPIRATION_TIME=60   # Temps d'expiration en secondes
MAX_RETRIES=3        # Nombre de tentatives en cas d'erreur
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR

# Options de déploiement
# ENV=production
